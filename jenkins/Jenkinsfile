pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        string(
            name: 'APP_SOURCE_REPO',
            defaultValue: 'https://github.com/dockersamples/example-voting-app.git',
            description: 'Application Git repository'
        )

        string(
            name: 'APP_BRANCH',
            defaultValue: 'main',
            description: 'Application Git branch'
        )

        string(
            name: 'PIPELINE_SOURCE_REPO',
            defaultValue: 'https://github.com/nimbuswiztech/VotingApp-EKS-Jenkins-CICD.git',
            description: 'Repository containing Kubernetes manifests'
        )

        string(
            name: 'PIPELINE_BRANCH',
            defaultValue: 'main',
            description: 'Branch containing Kubernetes manifests'
        )

        booleanParam(
            name: 'DEPLOY_TO_EKS',
            defaultValue: true,
            description: 'Deploy application to the existing EKS cluster'
        )
    }

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_PREFIX = 'votingapp'
        K8S_NAMESPACE = 'votingapp'
        EKS_CLUSTER_NAME = 'k8s'
        // Keep each build's checkout separate. Old workspaces can contain files
        // that Jenkins cannot remove (for example, files created by root in Docker).
        APP_DIR = "app-${BUILD_NUMBER}"
        MANIFEST_DIR = "pipeline-${BUILD_NUMBER}/kubernetes/eks"
        KUBECONFIG = "${WORKSPACE}/.kube/eks-config"
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout Source') {
            steps {
                dir("${APP_DIR}") {
                    git branch: "${params.APP_BRANCH}",
                        url: "${params.APP_SOURCE_REPO}"
                }

                dir("pipeline-${BUILD_NUMBER}") {
                    git branch: "${params.PIPELINE_BRANCH}",
                        url: "${params.PIPELINE_SOURCE_REPO}"
                }

                sh '''
                    set -eu

                    for component in vote result worker; do
                        test -f "$APP_DIR/$component/Dockerfile" || {
                            echo "ERROR: Missing Dockerfile for $component"
                            exit 1
                        }
                    done

                    for manifest in 00-namespace 01-postgres 02-redis 03-vote 04-result 05-worker; do
                        test -f "pipeline-$BUILD_NUMBER/kubernetes/eks/$manifest.yaml" || {
                            echo "ERROR: Missing Kubernetes manifest $manifest.yaml"
                            exit 1
                        }
                    done
                '''
            }
        }

        stage('Build and Push Images') {
            steps {
                script {
                    env.AWS_ACCOUNT_ID = sh(
                        script: '''
                            aws sts get-caller-identity \
                              --query Account \
                              --output text
                        ''',
                        returnStdout: true
                    ).trim()

                    env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"
                    env.VOTE_IMAGE = "${env.ECR_REGISTRY}/${env.ECR_PREFIX}-vote:${env.IMAGE_TAG}"
                    env.RESULT_IMAGE = "${env.ECR_REGISTRY}/${env.ECR_PREFIX}-result:${env.IMAGE_TAG}"
                    env.WORKER_IMAGE = "${env.ECR_REGISTRY}/${env.ECR_PREFIX}-worker:${env.IMAGE_TAG}"
                }

                sh '''
                    set -eu

                    echo "Logging in to ECR..."
                    aws ecr get-login-password --region "$AWS_REGION" \
                        | docker login --username AWS --password-stdin "$ECR_REGISTRY"

                    echo "Creating ECR repositories if required..."
                    for component in vote result worker; do
                        repository="${ECR_PREFIX}-${component}"

                        if ! aws ecr describe-repositories \
                            --repository-names "$repository" \
                            --region "$AWS_REGION" >/dev/null 2>&1; then
                            aws ecr create-repository \
                                --repository-name "$repository" \
                                --region "$AWS_REGION" \
                                --image-scanning-configuration scanOnPush=true
                        fi
                    done

                    echo "Building application images..."
                    docker build -t "$VOTE_IMAGE" "$APP_DIR/vote"
                    docker build -t "$RESULT_IMAGE" "$APP_DIR/result"
                    docker build -t "$WORKER_IMAGE" "$APP_DIR/worker"

                    echo "Pushing application images..."
                    docker push "$VOTE_IMAGE"
                    docker push "$RESULT_IMAGE"
                    docker push "$WORKER_IMAGE"
                '''
            }
        }

        stage('Deploy to EKS') {
            when {
                expression { return params.DEPLOY_TO_EKS }
            }

            steps {
                sh '''
                    set -eu

                    echo "Configuring EKS access..."
                    mkdir -p "$(dirname "$KUBECONFIG")"
                    aws eks update-kubeconfig \
                        --region "$AWS_REGION" \
                        --name "$EKS_CLUSTER_NAME" \
                        --kubeconfig "$KUBECONFIG"

                    echo "Applying Kubernetes manifests..."
                    kubectl apply -f "$MANIFEST_DIR/00-namespace.yaml"
                    kubectl apply -f "$MANIFEST_DIR/01-postgres.yaml"
                    kubectl apply -f "$MANIFEST_DIR/02-redis.yaml"
                    kubectl apply -f "$MANIFEST_DIR/03-vote.yaml"
                    kubectl apply -f "$MANIFEST_DIR/04-result.yaml"
                    kubectl apply -f "$MANIFEST_DIR/05-worker.yaml"

                    echo "Updating image tags..."
                    kubectl set image deployment/voting-app-deploy \
                        vote="$VOTE_IMAGE" \
                        -n "$K8S_NAMESPACE"
                    kubectl set image deployment/result-app-deploy \
                        result="$RESULT_IMAGE" \
                        -n "$K8S_NAMESPACE"
                    kubectl set image deployment/worker-deploy \
                        worker="$WORKER_IMAGE" \
                        -n "$K8S_NAMESPACE"

                    echo "Waiting for rollouts to complete..."
                    kubectl rollout status deployment/postgres-deploy -n "$K8S_NAMESPACE" --timeout=300s
                    kubectl rollout status deployment/redis-deploy -n "$K8S_NAMESPACE" --timeout=300s
                    kubectl rollout status deployment/voting-app-deploy -n "$K8S_NAMESPACE" --timeout=300s
                    kubectl rollout status deployment/result-app-deploy -n "$K8S_NAMESPACE" --timeout=300s
                    kubectl rollout status deployment/worker-deploy -n "$K8S_NAMESPACE" --timeout=300s
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }

        always {
            sh '''
                if [ -n "${ECR_REGISTRY:-}" ]; then
                    docker logout "$ECR_REGISTRY" >/dev/null 2>&1 || true
                fi
            '''
        }
    }
}
